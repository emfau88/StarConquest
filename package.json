{
  "name": "starconquest-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "balance:sim": "tsx scripts/balance-sim.ts",
    "check": "tsc --noEmit",
    "test": "npm run test:legacy && npm run test:assets && npm run test:game",
    "test:assets": "node --test tests/runtime-assets.test.mjs",
    "test:legacy": "node --test tests/core-mechanics.test.mjs tests/legacy-snapshot.test.mjs",
    "test:game": "tsx --test tests/game-simulation.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
